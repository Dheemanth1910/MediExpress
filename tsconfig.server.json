{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
    "module": "nodenext",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "drizzle.config.ts"],
  "exclude": ["src/client"]
}
